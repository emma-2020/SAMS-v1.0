# ============================================================
# SAMS v1.0 — Root .gitignore
# ============================================================

# Environment files — NEVER commit these
**/.env
**/.env.local
**/.env.production
**/.env.staging

# Node modules
node_modules/
**/node_modules/

# Build outputs
.next/
**/.next/
.expo/
**/.expo/
frontend/build/
frontend/.cache/
apps/next/.next/
apps/next/tsconfig.tsbuildinfo
apps/expo/.expo/

# Capacitor static export (regenerated by `next build` + `cap sync`)
apps/next/out/

# Native mobile build outputs (regenerated by Gradle/Xcode; do not commit signed artifacts)
apps/next/android/app/release/
apps/next/android/app/build/
apps/next/android/build/
apps/next/ios/build/

# Turborepo cache
.turbo/
**/.turbo/

# Backend compiled output (if added later)
backend/dist/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
.DS_Store?
Thumbs.db
._*
.Spotlight-V100
.Trashes

# IDE / editor
.vscode/
.idea/
*.swp
*.swo

# Test coverage
coverage/
.nyc_output/

# Misc
*.pem

# Local scratch / one-off debug & QA scripts — never intended for the repo
scratch/
