# =============================================
# SAMS Backend — Environment Variables
# Copy to .env and fill in real values
# NEVER commit .env to version control
# =============================================

NODE_ENV=development
PORT=4000

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key    # server-side only, never exposed to client
SUPABASE_ANON_KEY=your-supabase-anon-key

# JWT — used to verify Supabase JWTs issued to academy users
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Platform admin JWT — MUST be a separate secret from SUPABASE_JWT_SECRET.
# Generate with: node -e "require('crypto').randomBytes(48).toString('hex')|console.log"
# Add this to Railway / your deployment host as a separate env variable.
# If omitted, falls back to SUPABASE_JWT_SECRET (not recommended for production).
PLATFORM_JWT_SECRET=your-separate-platform-jwt-secret

# Email — Resend (https://resend.com)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM="SAMS Platform <noreply@mail.yourdomain.com>"

# App URLs
FRONTEND_URL=http://localhost:3001
MARKETING_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000

# Error monitoring — Sentry (https://sentry.io). Optional: leave unset to disable
# (config/sentry.js no-ops cleanly with no DSN — nothing else needs to change).
SENTRY_DSN=
