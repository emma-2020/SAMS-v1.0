# =============================================
# SAMS Backend — Environment Variables
# Copy to .env and fill in real values
# NEVER commit .env to version control
# =============================================

NODE_ENV=development
PORT=4000

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key    # server-side only, never exposed to client
SUPABASE_ANON_KEY=your-supabase-anon-key

# JWT (used to verify Supabase JWTs)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Email (for invitation emails)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@youracademy.com
SMTP_PASS=your-smtp-password
EMAIL_FROM="SAMS Platform <noreply@youracademy.com>"

# App
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
